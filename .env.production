# Production Environment Variables
# ==================================
# This file is used for production builds
# Do NOT commit sensitive values to git

# Backend API Configuration - Production
# Domain: api.algoai.biz → VPS 62.171.182.188 (update DNS A record)
VITE_API_BASE_URL=https://api.algoai.biz/api
VITE_API_URL=https://api.algoai.biz
VITE_WS_BASE_URL=wss://api.algoai.biz

# Environment mode
VITE_ENV=production

# Disable debug features in production
VITE_DEBUG=false

# Google OAuth (Production)
# Get these from Google Cloud Console (production credentials)
VITE_GOOGLE_CLIENT_ID=

# Other production settings
VITE_ENABLE_MOCK_DATA=false
VITE_LOG_LEVEL=error
